    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.14.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.0"
  }
